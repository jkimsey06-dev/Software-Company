# Copy to .env.local (apps/web) or your shell. Never commit real values.

# Supabase (dev project only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (server only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public https origin Twilio calls, e.g. https://app.example.com (no trailing path).
# Used to verify webhook signatures and build callback URLs. Must match exactly
# what is configured on the Twilio number.
PUBLIC_BASE_URL=

# Claude API (server only)
ANTHROPIC_API_KEY=

# Resend (server only). Owner notification emails and operator alerts.
# Without RESEND_API_KEY and NOTIFICATIONS_FROM_EMAIL, calls still work but no emails are sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Front Office <alerts@yourdomain.com>
NOTIFICATIONS_FROM_EMAIL=
# Where system alerts go (outages, stuck notifications). Optional: if empty, alerts are only logged.
OPS_ALERT_EMAIL=

# Protects /api/cron/notifications. At least 32 random characters, e.g. `openssl rand -hex 32`.
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Calendar OAuth (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local RLS tests (supabase/scripts/test-rls-local.sh)
# Postgres URL for a throwaway local database. Never point this at staging or prod.
RLS_TEST_DATABASE_URL=
